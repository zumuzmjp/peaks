# PEAKS server configuration. Every value is optional; demo mode needs nothing.
# Copy to .env (or .env.local) and adjust.

# Allow analysing real YouTube / Twitch URLs. Requires yt-dlp and ffmpeg.
# Set to false to run a demo-only instance (e.g. a public deployment).
PEAKS_ENABLE_LIVE=true

# Binaries. Defaults assume both are on PATH.
PEAKS_YTDLP_PATH=yt-dlp
PEAKS_FFMPEG_PATH=ffmpeg

# Extra arguments appended to every yt-dlp call, e.g. cookies for members-only
# streams or a rate limit. Space separated.
# PEAKS_YTDLP_ARGS=--cookies-from-browser firefox --limit-rate 2M

# Where chat + loudness signals (and temporary audio) are cached. Re-running a
# URL with a different sensitivity is instant once cached.
PEAKS_CACHE_DIR=.peaks-cache

# Refuse streams longer than this (hours). Longer streams take proportionally longer.
PEAKS_MAX_DURATION_HOURS=8

# Parallel GraphQL requests when fetching Twitch chat replay (1-8).
PEAKS_TWITCH_CHAT_WORKERS=4

# Client ID used for Twitch's public GraphQL endpoint (the one the web player uses).
# Only change this if Twitch rotates it.
# PEAKS_TWITCH_CLIENT_ID=

# Keep the downloaded audio file after analysis (debugging). Default: delete it.
PEAKS_KEEP_AUDIO=false

# How long finished jobs stay available at /app?job=<id> (minutes).
PEAKS_JOB_TTL_MINUTES=120
